@using Syncfusion.EJ2
@inject AppointmentService service

@{
   DateTime datepickerValue = new DateTime(2020, 1, 31);
}

<div class="new-patient-container" style="display:none">
  <ejs-dialog id="newFleetObj" width="390px" cssClass="new-patient-dialog" isModal="true" visible="false"
    header="New Fleet" showCloseIcon="true" target="body" beforeOpen="onFleetDialogBeforeOpen" footerTemplate="<div class='button-container'>
    <button id='cancel'>Cancel</button><button id='save'>Save</button></div>">
    <e-dialog-animationsettings effect="None"></e-dialog-animationsettings>
    <e-content-template>
      <form id="new-fleet-form">
        <div class="field-container name-container">
          <ejs-textbox id="Registration" name="Registration" cssClass="e-field" placeholder="Registration"
            floatLabelType="Always"></ejs-textbox>
        </div>
        <div class="field-container make-container">
        <div class="make">
            <ejs-textbox id="Make" name="Make" cssClass="e-field" placeholder="Make"
            floatLabelType="Always"></ejs-textbox>          
        </div>
        </div>
        <div class="field-container model-container">
          <ejs-textbox id="Model" name="Model" cssClass="e-field" placeholder="Model"
            floatLabelType="Always"></ejs-textbox>
        </div>
        <div class="field-container gender-container">
          <div class="gender">
            <div><label>Rented</label></div>           
            <ejs-radiobutton id="radioRentedFalse" label="True" value="False" name="state" checked="true"></ejs-radiobutton>
            <ejs-radiobutton id="radioRentedTrue" label="False" value="True" name="state"></ejs-radiobutton>
          </div>
          <div class="dob">
            <ejs-datepicker id="Year" cssClass="e-field" placeholder="Year" value="datepickerValue" format="yyyy"  floatLabelType="Always"
              showClearButton="false"></ejs-datepicker>
          </div>
          <div class="depot">
            <ejs-dropdownlist id="DepotID" width="125px" cssClass="e-field" placeholder="Select Depot" index=0 enabled="true"  name="DepotID"
              floatLabelType="Always" dataSource="@ViewBag.Depots">
              <e-dropdownlist-fields text="Name" value="ID"></e-dropdownlist-fields>
            </ejs-dropdownlist>
          </div>
        </div>
       
          
      </form>
    </e-content-template>
  </ejs-dialog>
</div>

<script type="text/javascript">
    var activeFleetData;
    function onAddFleet() {
        if (document.querySelector("#newFleetObj")) {
            var dialogObj = document.querySelector("#newFleetObj").ej2_instances[0];
            dialogObj.header = 'New Fleet';
            dialogObj.show();
        }
    }
    function onFleetDialogBeforeOpen(args) {
        var cancelBtn = args.element.querySelector('#cancel');
        var saveBtn = args.element.querySelector('#save');
        if (cancelBtn) {
            var btnObj = new ej.buttons.Button({
                cssClass: 'e-normal'
            });
            btnObj.appendTo(cancelBtn);
            cancelBtn.onclick = function (e) { onFleetCancelClick(e); };
        }
        if (saveBtn) {
            var btnObj = new ej.buttons.Button({
                cssClass: 'e-normal',
                isPrimary: true
            });
            btnObj.appendTo(saveBtn);
            saveBtn.onclick = function (e) { onFleetSaveClick(e); };
        }

        var formElement = args.element.querySelector('#new-patient-form');
        if (formElement && formElement.ej2_instances) {
            return;
        }
        var customFn = (e) => {
            var argsLength = e.element.ej2_instances[0].value.length;
            return (argsLength !== 0) ? argsLength >= 10 : false;
        };
        var rules = {};
        rules.Registration = { required: [true, 'Enter valid name'] };       
        
        renderFormValidator(formElement, rules, document.querySelector("#newFleetObj").ej2_instances[0].element);
    }

    function onFleetSaveClick(e) {
        var formElementContainer = document.querySelector('.new-patient-dialog #new-patient-form');
        if (formElementContainer && formElementContainer.classList.contains('e-formvalidator') &&
            !formElementContainer.ej2_instances[0].validate()) {
            return;
        }
        var dialogObj = document.querySelector("#newFleetObj").ej2_instances[0];
        var obj = dialogObj.header == 'New Fleet' ? {} : activeFleetData;
        var formElement = [].slice.call(document.querySelectorAll('.new-patient-dialog .e-field'));
        for (var curElement of formElement) {
            var columnName = curElement.querySelector('input').name;            
            var isDropElement = curElement.classList.contains('e-ddl');
            var isDatePickElement = curElement.classList.contains('e-date-wrapper');
            if (!ej.base.isNullOrUndefined(columnName) || isDropElement || isDatePickElement) {
                if (columnName === '' && isDropElement) {
                    columnName = curElement.querySelector('select').name;
                    var instance = curElement.querySelector('input').ej2_instances[0];
                    obj[columnName] = instance.value;
                } else if (columnName === 'Year' && isDatePickElement) {
                    var instance = curElement.querySelector('input').ej2_instances[0];
                    obj[columnName] = instance.value;
                } else if (columnName === 'Rented') {
                    obj[columnName] = curElement.querySelector('input').checked ? 'False' : 'True';
                 } else if (columnName === 'DepotID') {
                    obj['DepotID'] = '1';
                    
                } else {
                    obj[columnName] = curElement.querySelector('input').value;
                }
            }
        }
        fetch('/Home/findFleet', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(obj['Registration'])
        })
        .then(response => {
            if (response.ok) {
                alert('Fleet found');
            }
            else if (!response.ok) {
            // Handle the fleet data here
             var ajaxHTML = new ej.base.Ajax('Home/UpdateFleetData', 'POST', true);
            ajaxHTML.send(JSON.stringify(obj)).then(function (value) {
                var gridele = document.querySelector('#fleetsGrid')
                var comboBoxEle = document.querySelector('.e-schedule-dialog #Registration')
                var currentRenderedPage = getCurrentPage();
                if (currentRenderedPage === 'fleets' && gridele && gridele.ej2_instances[0]) {
                    var gridObj = document.querySelector('#fleetsGrid').ej2_instances[0];
                    if (dialogObj.header == 'New Fleet') {
                        obj.Id = Math.max.apply(Math, gridObj.dataSource.map(data => data.Id)) + 1;
                        gridObj.addRecord(obj, gridObj.dataSource.length);
                    }
                    else {
                        var index = gridObj.dataSource.findIndex(x => x.Registration == activeFleetData.Registration);
                        gridObj.dataSource[index] = obj;
                        gridObj.refresh();
                    }
                }
                else if (currentRenderedPage === 'calendar' && comboBoxEle && comboBoxEle.ej2_instances[0]) {
                    obj = JSON.parse(value);
                    var dataSource = comboBoxEle.ej2_instances[0].dataSource;
                    comboBoxEle.ej2_instances[0].dataSource = [];
                    dataSource.push(obj);
                    comboBoxEle.ej2_instances[0].dataSource = dataSource;
                }
            }).catch(function (error) {
                console.error('Error updating fleet data:', error);
                alert('An error occurred while saving fleet data. Please check the console for details.');
            });
                resetFleetFormFields();
                dialogObj = document.querySelector("#newFleetObj").ej2_instances[0];
                dialogObj.hide();
            // You can update the UI or process the data as needed
            }
            
        })
        .then(data => {
            if (!response.ok) {
            // Handle the fleet data here
            // The following code block was missing a closing brace for the .then() function
           console.log('Fleet found:', data);

            // You can update the UI or process the data as needed
            }
        })
        .catch(error => {
            // Handle errors here
            console.error('Error:', error.message);
        }); 
    }

    function onFleetCancelClick(e) {
        resetFleetFormFields();
        if (document.querySelector("#newFleetObj")) {
            var dialogObj = document.querySelector("#newFleetObj").ej2_instances[0];
            dialogObj.hide();
        }
    }
    function resetFleetFormFields() {
        var formElement = [].slice.call(document.querySelectorAll('.new-patient-dialog .e-field'));
        destroyErrorElement(document.querySelector('#new-patient-form'), formElement);
        for (var curElement of formElement) {
            var columnName = curElement.querySelector('input').name;
            var isDropElement = curElement.classList.contains('e-ddl');
            var isDatePickElement = curElement.classList.contains('e-date-wrapper');
            if (!ej.base.isNullOrUndefined(columnName) || isDropElement || isDatePickElement) {
                if (columnName === '' && isDropElement) {
                    columnName = curElement.querySelector('select').name;
                    var instance = curElement.querySelector('input').ej2_instances[0];
                    instance.value = instance.dataSource[0];
                } else if (columnName === 'DOB' && isDatePickElement) {
                    var instance = curElement.querySelector('input').ej2_instances[0];
                    instance.value = new Date();
                    curElement.querySelectorAll('input')[0].checked = true;
                } else if (columnName === 'Gender') {
                    curElement.querySelectorAll('input')[0].checked = true;
                } else if (columnName === 'Mobile') {
                    curElement.querySelector('input').value = '';
                } else {
                    curElement.querySelector('input').value = '';
                }
            }
        }
    }
        function findFleet(registration) {
        fetch('/Home/findFleet', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(registration)
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Fleet not found');
            }
            return response.json();
        })
        .then(data => {
            // Handle the fleet data here
            console.log('Fleet found:', data);
            // You can update the UI or process the data as needed
        })
        .catch(error => {
            // Handle errors here
            console.error('Error:', error.message);
        });
    }
    function findFleetByRegistration(registration) 
    {
        return fetch('/Home/findFleet', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(registration)
        })
        .then(response => {
             if (!response.ok) {
                throw new Error(response);
            }
           
            return response.json();
        });
    }
    function showFleetDetails(activeData) {
        var dialogObj = document.querySelector("#newFleetObj").ej2_instances[0];
        dialogObj.header = 'Edit Patient';
        dialogObj.show();
        var obj = activeData;
        activeFleetData = activeData;
        var depotData = @Html.Raw(Json.Serialize(ViewBag.Depots));
        var formElement = [].slice.call(document.querySelectorAll('.new-patient-dialog .e-field'));
        for (var curElement of formElement) {
            var columnName = curElement.querySelector('input').name;
            var isCustomElement = curElement.classList.contains('e-ddl');
            var isDatePickElement = curElement.classList.contains('e-date-wrapper');
            if (!ej.base.isNullOrUndefined(columnName) || isCustomElement || isDatePickElement) {
                if (columnName === '' && isCustomElement) {
                    columnName = curElement.querySelector('select').name;
                    var instance = curElement.querySelector('input').ej2_instances[0];
                    instance.value = obj[columnName];
                    instance.dataBind();
                } else if (columnName === 'Year' && isDatePickElement) {
                    var instance = curElement.querySelector('input').ej2_instances[0];
                    instance.value = obj[columnName] || null;
                } else if (columnName === 'Rented') {
                    if (obj[columnName] === 'True') {
                        curElement.querySelectorAll('input')[1].checked = true;
                    } else {
                        curElement.querySelectorAll('input')[0].checked = true;
                    }               
                } else if (columnName === 'Mobile') {
                    curElement.querySelector('input').ej2_instances[0].value =
                        obj[columnName].replace(/[ -.*+?^${}()|[\]\\]/g, '');
                } else {
                    curElement.querySelector('input').value = obj[columnName];
                }
            }
        }
    }
</script>

<style>
.new-patient-dialog {
	max-height: 98% !important;
}

.new-patient-dialog .e-dlg-content #new-patient-form .field-container {
	padding-bottom: 16px;
}

.new-patient-dialog .e-dlg-content #new-patient-form .gender-container,
.new-patient-dialog .e-dlg-content #new-patient-form .contact-container {
	display: flex;
}

.new-patient-dialog .e-dlg-content #new-patient-form .gender-container .gender,
.new-patient-dialog .e-dlg-content #new-patient-form .contact-container .gender {
	padding-right: 8px;
	flex: 1;
}

.new-patient-dialog .e-dlg-content #new-patient-form .gender-container .gender .e-btn-group input:checked+label.e-btn,
.new-patient-dialog .e-dlg-content #new-patient-form .contact-container .gender .e-btn-group input:checked+label.e-btn {
	background-color: #e6e6e6;
	border-color: #adadad;
	box-shadow: inset 0 3px 5px #000 20;
	color: #333;
	outline: 0 solid #fff;
	outline-offset: 0;
}

.new-patient-dialog .e-dlg-content #new-patient-form .gender-container .mobile,
.new-patient-dialog .e-dlg-content #new-patient-form .contact-container .mobile {
	padding-left: 8px;
	flex: 1;
}

.new-patient-dialog .e-dlg-content #new-patient-form .contact-container .blood-group,
.new-patient-dialog .e-dlg-content #new-patient-form .gender-container .dob {
	padding-left: 8px;
	flex: 1;
}

.new-patient-dialog .e-dlg-content #new-patient-form .gender-container .gender {
	display: flex;
	flex-direction: column;
}

.new-patient-dialog .e-dlg-content #new-patient-form .gender-container .gender label:not(.e-btn) {
	font-weight: bold;
	color: #333;
	font-size: 12px;
	font-family: "Helvetica Neue", "Helvetica", "Arial", sans-serif, "-apple-system", "BlinkMacSystemFont";
}

.new-patient-dialog .e-dlg-content #new-patient-form .gender-container .gender .e-btn-group {
	height: 32px;
	margin-top: 8px;
}

.new-patient-dialog .e-dlg-content #new-patient-form .gender-container .gender .e-btn-group label {
	width: 50%;
}
</style>
