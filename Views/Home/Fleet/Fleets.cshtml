  max-height: 495px !important;
}

.e-dialog.e-edit-dialog .e-dlg-content .grid-edit-dialog {
  width: 325px;
  height: 360px;
}

.e-dialog.e-edit-dialog .e-dlg-content .grid-edit-dialog .field-row {
  display: flex;
  padding: 5px 0;
